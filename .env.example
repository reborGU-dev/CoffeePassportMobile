# URL de la API local de pruebas.
# Copia este archivo como .env y pon la dirección de tu servidor.
#
#   Emulador Android            -> http://10.0.2.2:5018
#   Teléfono físico (misma Wi-Fi) -> http://192.168.1.100:5018
#   Simulador iOS / web         -> http://localhost:5018
#
EXPO_PUBLIC_API_URL=http://192.168.1.100:5018
